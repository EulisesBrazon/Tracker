# Ejemplo de archivo de variables de entorno
# Copia este archivo a .env o .env.local y rellena los valores reales.

# Entorno
NODE_ENV=development

# API pública (para Next.js usar NEXT_PUBLIC_ para exponer al cliente)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Base de datos (ejemplo PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Autenticación / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me

