# Ejemplo de archivo de variables de entorno
# Copia este archivo a .env o .env.local y rellena los valores reales.

# Entorno
NODE_ENV=development

# Base de datos (ejemplo PostgreSQL)
DATABASE_URL=mongodb://localhost:27017/Traker

# Palabra secreta para JWT
JWT_SECRET="tu_secreto_jwt_aqui"

# Token para trabajos cron
CRON_TOKEN="token_para_cron_jobs_aqui"

# Token para la API pública de tasas (/api/public/*), consumida servidor-a-servidor.
# Se envía en el header `x-api-token`. Genéralo con: npm run generate-api-token
# Si esta variable no está definida, los endpoints /api/public/* quedan cerrados.
API_TOKEN="token_para_consumidores_de_la_api_aqui"

#creacion de usarios
USER_USERNAME=usuario1
USER_PASSWORD=contraseñaSegura123
USER_EMAIL=usuario1@example.com